# Copy to .env.local (local) or set in your hosting provider's environment settings.

# Google Apps Script web app URL for exam-preparation registrations.
# See integrations/google-sheets/README.md for setup.
VITE_TUTORIALS_SHEET_URL=

# Set to "true" once the backend is deployed, to also save registrations to MongoDB.
VITE_TUTORIALS_USE_API=false
